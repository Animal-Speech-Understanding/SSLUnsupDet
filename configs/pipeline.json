{
    "dataset": {
        "window": 0.5,
        "wavs_path": "../../data/wavs48khz/*.wav",
        "sample_rate": 48000,
        "window_pad": 136,
        "train_samples": 12500,
        "val_samples": 3125,
        "seed": 42,
        "epsilon": 2e-6
    },
    "model": {
        "filter_params": {
            "cutoff_freq": 3000,
            "sample_rate": 48000
        },
        "conv_transform_params": {
            "in_channels": 1,
            "layer_configs": [
                [128, 8, 4, 0],
                [128, 6, 3, 0],
                [128, 4, 2, 0],
                [128, 4, 2, 0]
            ],
            "use_bn": true,
            "bias": true
        },
        "mlp_params": {
            "dropout": 0,
            "out_dim": 32,
            "layers":  []
        }
    },
    "training": {
        "batch_size": 64,
        "epochs": 50,
        "n_negatives": 2
    },
    "inference": {
        "coarse": {
            "alpha": [0.1, 1.1, 0.1],
            "beta": [-1, 1.1, 0.1],
            "smooth_duration": [0, 30, 5]
        },
        "fine" : {
            "alpha": [0.01, 0.21, 0.01],
            "beta": [0.8, 1.01, 0.01],
            "smooth_duration": [0, 11, 1]
        },
        "duration_threshold": 30
    },
    "detection": {
        "coarse": {
            "prominence": [0.05, 0.8, 0.05]
        },
        "fine": {
            "prominence": [0.01, 0.21, 0.01]
        }
    },
    "metrics" : {
        "tolerance" : [0.005, 0.01, 0.02],
        "coarsen": [0.005, 0.01, 0.02]
    },
    "utils": {
        "save_dir": "Pipeline"
    }
}
